{
  "openapi": "3.1.0",
  "info": {
    "title": "Confluence Connector Service",
    "description": "Publishes Agentic SDLC project documentation to Confluence Cloud: a project page, one folder per\ndocumentation category, and file attachments.\n\nCredentials: `CONFLUENCE_EMAIL` + `CONFLUENCE_API_TOKEN` (scoped Atlassian API token), plus\n`CONFLUENCE_CLOUD_ID` and `CONFLUENCE_BASE_URL`. Enable live calls with `CONFLUENCE_LIVE=1`.\n\n**Setup guide:** [Confluence setup](https://github.com/csdmichael/Foundry-Agentic-Workflow-SDLC-Docs/blob/main/docs/setup/connectors/confluence.md)\n\n**Authentication:** send `X-Connector-Api-Key: <CONNECTOR_SERVICE_API_KEY>` on every request except `GET /health`. Optionally send `X-Caller` (recorded in the audit log) and `x-correlation-id` (echoed back).",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe (anonymous)",
        "description": "Returns 200 when the process is running. Makes no outbound call and returns no configuration.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Configuration readiness",
        "description": "Checks that the connector is enabled and live and that every required setting is present. Returns 200 when ready and 503 otherwise. Setting values are never returned.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
    "/health/connectivity": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live, read-only connectivity probe",
        "description": "Authenticates to the external system and performs one read-only call. Returns 200 when the credential and permissions are accepted, 409 in mock/disabled mode, and 502/503 on failure.",
        "operationId": "connectivity_health_connectivity_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled or in mock mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "502": {
            "description": "External system rejected the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "503": {
            "description": "Credential unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
    "/api/v1/space": {
      "get": {
        "tags": [
          "space"
        ],
        "summary": "Resolve the configured Confluence space (read-only)",
        "operationId": "get_space_api_v1_space_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Space Api V1 Space Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
    "/api/v1/projects/structure": {
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Create (or reuse) the project page tree",
        "description": "Creates the project page, a folder per documentation category, and attachment pages in the configured space. Idempotent: existing resources are reused. Creates the space only when createSpaceIfMissing=true.",
        "operationId": "ensure_structure_api_v1_projects_structure_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectRef"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Ensure Structure Api V1 Projects Structure Post"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
    "/api/v1/projects/documents": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Publish a document as an attachment",
        "description": "Uploads the file to the category's attachment page and refreshes the project page links.",
        "operationId": "publish_document_api_v1_projects_documents_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DocumentUploadBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Publish Document Api V1 Projects Documents Post"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
    "/api/v1/rpc": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Execute a connector operation for the factory API",
        "description": "Internal contract used by the factory API: executes one allow-listed public method of the Confluence client with JSON-encoded arguments and returns its JSON-encoded result. Callback arguments are recorded and returned for replay by the caller.",
        "operationId": "rpc_api_v1_rpc_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RpcRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Unknown method",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ConnectivityResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "connected or failed",
            "examples": [
              "connected"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "connector": {
            "type": "string",
            "title": "Connector"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "durationMs": {
            "type": "integer",
            "title": "Durationms"
          },
          "identity": {
            "additionalProperties": true,
            "type": "object",
            "title": "Identity",
            "description": "Non-secret identity summary"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "mode",
          "durationMs"
        ],
        "title": "ConnectivityResponse"
      },
      "DocumentUploadBody": {
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectRef"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Category key from the connector's categoryFolders configuration",
            "default": "supporting",
            "examples": [
              "requirements"
            ]
          },
          "fileName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Filename",
            "examples": [
              "connector-verification.md"
            ]
          },
          "contentBase64": {
            "type": "string",
            "title": "Contentbase64",
            "description": "Base64-encoded file content (max 25 MB decoded)"
          },
          "contentType": {
            "type": "string",
            "title": "Contenttype",
            "default": "application/octet-stream",
            "examples": [
              "text/markdown; charset=utf-8"
            ]
          }
        },
        "type": "object",
        "required": [
          "project",
          "fileName",
          "contentBase64"
        ],
        "title": "DocumentUploadBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlationid"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "examples": [
              "jira-connector"
            ]
          },
          "connector": {
            "type": "string",
            "title": "Connector",
            "examples": [
              "jira"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "1.0.0"
            ]
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "live, mock, or disabled",
            "examples": [
              "live"
            ]
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "version",
          "mode",
          "timestamp"
        ],
        "title": "LivenessResponse"
      },
      "ProjectRef": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id",
            "examples": [
              "3f9c2a7e-connector-verify"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "Connector Verification"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "ProjectRef",
        "description": "The SDLC project a documentation operation belongs to."
      },
      "ReadinessCheckModel": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "JIRA_API_TOKEN"
            ]
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "title": "ReadinessCheckModel"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "ready or not_ready",
            "examples": [
              "ready"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "connector": {
            "type": "string",
            "title": "Connector"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheckModel"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "mode",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "RpcRequest": {
        "properties": {
          "method": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Method",
            "examples": [
              "create_project"
            ]
          },
          "args": {
            "items": {},
            "type": "array",
            "title": "Args"
          },
          "kwargs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Kwargs"
          },
          "init": {
            "additionalProperties": true,
            "type": "object",
            "title": "Init",
            "description": "Constructor overrides, for example a workspace"
          }
        },
        "type": "object",
        "required": [
          "method"
        ],
        "title": "RpcRequest"
      },
      "RpcResponse": {
        "properties": {
          "result": {
            "title": "Result"
          },
          "callbacks": {
            "additionalProperties": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Callbacks"
          }
        },
        "type": "object",
        "title": "RpcResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ConnectorApiKey": {
        "type": "apiKey",
        "description": "Service API key. The value is the `CONNECTOR_SERVICE_API_KEY` app setting of this connector service. Store it in Key Vault; never paste it into tickets or chat.",
        "in": "header",
        "name": "X-Connector-Api-Key"
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness, configuration readiness, and live connectivity probes. Use these after every setup step: `/health` proves the process is running, `/health/ready` proves required settings exist, and `/health/connectivity` proves the credential is accepted by the external system."
    },
    {
      "name": "space",
      "description": "Configured space lookup"
    },
    {
      "name": "projects",
      "description": "Project page tree provisioning"
    },
    {
      "name": "documents",
      "description": "Attachment publishing"
    }
  ]
}
