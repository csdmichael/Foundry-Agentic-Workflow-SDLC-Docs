{
  "openapi": "3.1.0",
  "info": {
    "title": "Jira Connector Service",
    "description": "Creates and manages the Jira Cloud records the Agentic SDLC factory owns: projects, backlog\nhierarchies (Epic \u2192 Story \u2192 Task), sprints, test plans and test cases.\n\nCredentials: `JIRA_EMAIL` + `JIRA_API_TOKEN` (unscoped Atlassian API token of a dedicated,\nlicensed automation account) and `JIRA_BASE_URL`. Enable live calls with `JIRA_LIVE=1`.\n\n**Setup guide:** [Jira setup](https://github.com/csdmichael/Foundry-Agentic-Workflow-SDLC-Docs/blob/main/docs/setup/connectors/jira.md)\n\n**Authentication:** send `X-Connector-Api-Key: <CONNECTOR_SERVICE_API_KEY>` on every request except `GET /health`. Optionally send `X-Caller` (recorded in the audit log) and `x-correlation-id` (echoed back).",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe (anonymous)",
        "description": "Returns 200 when the process is running. Makes no outbound call and returns no configuration.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Configuration readiness",
        "description": "Checks that the connector is enabled and live and that every required setting is present. Returns 200 when ready and 503 otherwise. Setting values are never returned.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
    "/health/connectivity": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live, read-only connectivity probe",
        "description": "Authenticates to the external system and performs one read-only call. Returns 200 when the credential and permissions are accepted, 409 in mock/disabled mode, and 502/503 on failure.",
        "operationId": "connectivity_health_connectivity_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled or in mock mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "502": {
            "description": "External system rejected the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "503": {
            "description": "Credential unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
