  "components": {
    "schemas": {
      "AdoBacklogItemBody": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "Task"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "acceptanceCriteria": {
            "type": "string",
            "title": "Acceptancecriteria",
            "default": ""
          },
          "parentIndex": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parentindex"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "AdoBacklogItemBody"
      },
      "ConnectivityResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "connected or failed",
            "examples": [
              "connected"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
