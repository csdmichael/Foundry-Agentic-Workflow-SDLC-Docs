{
  "openapi": "3.1.0",
  "info": {
    "title": "SharePoint Connector Service",
    "description": "Publishes Agentic SDLC project documentation to SharePoint Online through Microsoft Graph. In\n`perProjectSite` mode every SDLC project gets its own SharePoint site; in `sharedSite` mode projects\nget folders and a page inside `SHAREPOINT_SITE_URL`.\n\nIdentity: the App Service managed identity (same tenant) or an app registration in the SharePoint\ntenant (`SHAREPOINT_TENANT_ID`, `SHAREPOINT_CLIENT_ID`, `SHAREPOINT_CLIENT_SECRET` or\n`SHAREPOINT_CLIENT_CERTIFICATE_PATH`). Microsoft Graph application roles: `Sites.ReadWrite.All`, plus\n`Sites.Create.All` for per-project sites.\n\n**Setup guide:** [SharePoint setup](https://github.com/csdmichael/Foundry-Agentic-Workflow-SDLC-Docs/blob/main/docs/setup/connectors/sharepoint.md)\n\n**Authentication:** send `X-Connector-Api-Key: <CONNECTOR_SERVICE_API_KEY>` on every request except `GET /health`. Optionally send `X-Caller` (recorded in the audit log) and `x-correlation-id` (echoed back).",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe (anonymous)",
        "description": "Returns 200 when the process is running. Makes no outbound call and returns no configuration.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Configuration readiness",
        "description": "Checks that the connector is enabled and live and that every required setting is present. Returns 200 when ready and 503 otherwise. Setting values are never returned.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
    "/health/connectivity": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live, read-only connectivity probe",
        "description": "Authenticates to the external system and performs one read-only call. Returns 200 when the credential and permissions are accepted, 409 in mock/disabled mode, and 502/503 on failure.",
        "operationId": "connectivity_health_connectivity_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled or in mock mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "502": {
            "description": "External system rejected the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          },
          "503": {
            "description": "Credential unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectivityResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
