    "/api/v1/projects/{project}/workitems": {
      "get": {
        "summary": "Query work items with WIQL",
        "description": "Runs a WIQL query in the project. Omit `wiql` to list recently changed work items. WIQL has no LIMIT clause: use `top` to cap rows (trailing `LIMIT n` and `SELECT TOP n` are accepted and converted). Example: `SELECT [System.Id] FROM WorkItems WHERE [System.WorkItemType] = 'Epic'`.",
        "operationId": "ado_list_work_items",
        "security": [
          {
            "ConnectorApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "examples": [
                "Connector-Verification"
              ],
              "title": "Project"
            }
          },
          {
            "name": "wiql",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4000
                },
                {
                  "type": "null"
                }
              ],
              "title": "Wiql"
            }
          },
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 100,
              "title": "Top"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response List Work Items Api V1 Projects  Project  Workitems Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
