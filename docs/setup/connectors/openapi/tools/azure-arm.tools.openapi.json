    "securitySchemes": {
      "ConnectorApiKey": {
        "type": "apiKey",
        "description": "Service API key. The value is the `CONNECTOR_SERVICE_API_KEY` app setting of this connector service. Store it in Key Vault; never paste it into tickets or chat.",
