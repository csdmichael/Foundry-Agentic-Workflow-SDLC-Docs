              "pattern": "^[A-Za-z0-9._-]+$",
              "examples": [
                "agentic-sdlc-verify"
              ],
              "title": "Repo"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(open|closed|all)$",
              "default": "open",
              "title": "State"
            }
          }
        ],
        "responses": {
