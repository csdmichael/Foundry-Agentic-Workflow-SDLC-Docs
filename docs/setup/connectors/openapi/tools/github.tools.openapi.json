  "components": {
    "schemas": {
      "BranchCreateBody": {
        "properties": {
          "branch": {
            "type": "string",
            "title": "Branch"
          },
          "fromBranch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frombranch"
          }
        },
        "type": "object",
        "required": [
          "branch"
        ],
        "title": "BranchCreateBody"
      },
      "ConnectivityResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "connected or failed",
            "examples": [
              "connected"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "connector": {
            "type": "string",
            "title": "Connector"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "durationMs": {
            "type": "integer",
            "title": "Durationms"
          },
          "identity": {
            "additionalProperties": true,
            "type": "object",
            "title": "Identity",
            "description": "Non-secret identity summary"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "mode",
          "durationMs"
        ],
        "title": "ConnectivityResponse"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlationid"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FileCommitBody": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Update from Agentic SDLC"
          },
          "branch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Branch"
          }
        },
        "type": "object",
        "required": [
          "path",
          "content"
        ],
        "title": "FileCommitBody"
      },
      "GitHubRepoCreateBody": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "private": {
            "type": "boolean",
            "title": "Private",
            "default": true
          },
          "autoInit": {
            "type": "boolean",
            "title": "Autoinit",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "GitHubRepoCreateBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IssueCreateBody": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body",
            "default": ""
          },
          "labels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Labels",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "IssueCreateBody"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "examples": [
              "jira-connector"
            ]
          },
          "connector": {
            "type": "string",
            "title": "Connector",
            "examples": [
              "jira"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "1.0.0"
            ]
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "live, mock, or disabled",
            "examples": [
              "live"
            ]
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "version",
          "mode",
          "timestamp"
        ],
        "title": "LivenessResponse"
      },
      "PullRequestCreateBody": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "head": {
            "type": "string",
            "title": "Head"
          },
          "base": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base"
          },
          "body": {
            "type": "string",
            "title": "Body",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "title",
          "head"
        ],
        "title": "PullRequestCreateBody"
      },
      "ReadinessCheckModel": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "JIRA_API_TOKEN"
            ]
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "title": "ReadinessCheckModel"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "ready or not_ready",
            "examples": [
              "ready"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "connector": {
            "type": "string",
            "title": "Connector"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheckModel"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "mode",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "RpcRequest": {
        "properties": {
          "method": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Method",
            "examples": [
              "create_project"
            ]
          },
          "args": {
            "items": {},
            "type": "array",
            "title": "Args"
          },
          "kwargs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Kwargs"
          },
          "init": {
            "additionalProperties": true,
            "type": "object",
            "title": "Init",
            "description": "Constructor overrides, for example a workspace"
          }
        },
        "type": "object",
        "required": [
          "method"
        ],
        "title": "RpcRequest"
      },
      "RpcResponse": {
        "properties": {
          "result": {
            "title": "Result"
          },
          "callbacks": {
            "additionalProperties": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Callbacks"
          }
        },
        "type": "object",
        "title": "RpcResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkflowDispatchBody": {
        "properties": {
          "ref": {
            "type": "string",
            "title": "Ref",
            "default": "main"
          },
          "inputs": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Inputs",
            "default": {}
          }
        },
        "type": "object",
        "title": "WorkflowDispatchBody"
      }
    },
    "securitySchemes": {
      "ConnectorApiKey": {
        "type": "apiKey",
        "description": "Service API key. The value is the `CONNECTOR_SERVICE_API_KEY` app setting of this connector service. Store it in Key Vault; never paste it into tickets or chat.",
        "in": "header",
        "name": "X-Connector-Api-Key"
      }
    }
  },
  "servers": [
    {
      "url": "https://<api-app>-github.azurewebsites.net"
    }
  ],
  "security": [
    {
      "ConnectorApiKey": []
    }
  ]
}
