    "/api/v1/repos/{repo}/pulls": {
      "get": {
        "summary": "List pull requests",
        "operationId": "github_list_pulls",
        "security": [
          {
            "ConnectorApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "repo",
