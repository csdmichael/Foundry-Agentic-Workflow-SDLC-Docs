{
  "openapi": "3.1.0",
  "info": {
    "title": "GitHub read-only tools",
    "version": "1.0.0",
    "description": "Read-only lookups in GitHub for Agentic SDLC agents. Use them to ground proposals in existing records. These tools cannot create or modify anything; changes are proposed in the agent's output and published only after human approval."
  },
  "paths": {
    "/api/v1/repos": {
      "get": {
        "summary": "List repositories for the configured owner",
        "operationId": "github_list_repos",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response List Repos Api V1 Repos Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ConnectorApiKey": []
          }
        ]
      }
    },
    "/api/v1/repos/{repo}": {
      "get": {
        "summary": "Get a repository",
        "operationId": "github_get_repo",
        "security": [
          {
            "ConnectorApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9._-]+$",
              "examples": [
                "agentic-sdlc-verify"
              ],
              "title": "Repo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Repo Api V1 Repos  Repo  Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
