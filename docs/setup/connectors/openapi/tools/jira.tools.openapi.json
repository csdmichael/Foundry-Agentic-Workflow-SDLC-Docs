{
  "openapi": "3.1.0",
  "info": {
    "title": "Jira read-only tools",
    "version": "1.0.0",
    "description": "Read-only lookups in Jira for Agentic SDLC agents. Use them to ground proposals in existing records. These tools cannot create or modify anything; changes are proposed in the agent's output and published only after human approval."
  },
  "paths": {
    "/api/v1/projects/{key}": {
      "get": {
        "summary": "Get a Jira project",
        "operationId": "jira_get_project",
        "security": [
          {
            "ConnectorApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 10,
              "pattern": "^[A-Z][A-Z0-9]+$",
              "examples": [
                "SDLCVERIFY"
              ],
              "title": "Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Project Api V1 Projects  Key  Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{key}/issue-types": {
      "get": {
        "summary": "List issue types available in a project",
        "operationId": "jira_issue_types",
        "security": [
          {
            "ConnectorApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 10,
              "pattern": "^[A-Z][A-Z0-9]+$",
              "examples": [
                "SDLCVERIFY"
              ],
              "title": "Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "title": "Response Issue Types Api V1 Projects  Key  Issue Types Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdoBacklogItemBody": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "Task"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "acceptanceCriteria": {
            "type": "string",
            "title": "Acceptancecriteria",
            "default": ""
          },
          "parentIndex": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parentindex"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "AdoBacklogItemBody"
      },
      "ConnectivityResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "connected or failed",
            "examples": [
              "connected"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "connector": {
            "type": "string",
            "title": "Connector"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "durationMs": {
            "type": "integer",
            "title": "Durationms"
          },
          "identity": {
            "additionalProperties": true,
            "type": "object",
            "title": "Identity",
            "description": "Non-secret identity summary"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "mode",
          "durationMs"
        ],
        "title": "ConnectivityResponse"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlationid"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JiraBacklogBody": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AdoBacklogItemBody"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Items"
          },
          "templateId": {
            "type": "string",
            "title": "Templateid",
            "default": "scrum"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "JiraBacklogBody"
      },
      "JiraIterationBody": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "Sprint 1"
            ]
          },
          "startDate": {
            "type": "string",
            "title": "Startdate",
            "default": "",
            "examples": [
              "2026-10-01"
            ]
          },
          "finishDate": {
            "type": "string",
            "title": "Finishdate",
            "default": "",
            "examples": [
              "2026-10-14"
            ]
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "JiraIterationBody"
      },
      "JiraProjectCreateBody": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "Connector Verification"
            ]
          },
          "key": {
            "type": "string",
            "maxLength": 10,
            "pattern": "^([A-Z][A-Z0-9]+)?$",
            "title": "Key",
            "description": "Optional; derived from name",
            "default": ""
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description",
            "default": ""
          },
          "templateId": {
            "type": "string",
            "title": "Templateid",
            "description": "Template id from systems-of-record jiraProjectTemplates",
            "default": "scrum"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "JiraProjectCreateBody"
      },
      "JiraTestCaseBody": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1,
            "title": "Title"
          },
          "steps": {
            "type": "string",
            "maxLength": 20000,
            "title": "Steps",
            "default": ""
          },
          "templateId": {
            "type": "string",
            "title": "Templateid",
            "default": "scrum"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "JiraTestCaseBody"
      },
      "JiraTestPlanBody": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "templateId": {
            "type": "string",
            "title": "Templateid",
            "default": "scrum"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "JiraTestPlanBody"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "examples": [
              "jira-connector"
            ]
          },
          "connector": {
            "type": "string",
            "title": "Connector",
            "examples": [
              "jira"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "1.0.0"
            ]
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "live, mock, or disabled",
            "examples": [
              "live"
            ]
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "version",
          "mode",
          "timestamp"
        ],
        "title": "LivenessResponse"
      },
      "ReadinessCheckModel": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "JIRA_API_TOKEN"
            ]
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "title": "ReadinessCheckModel"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "ready or not_ready",
            "examples": [
              "ready"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "connector": {
            "type": "string",
            "title": "Connector"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheckModel"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "mode",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "RpcRequest": {
        "properties": {
          "method": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Method",
            "examples": [
              "create_project"
            ]
          },
          "args": {
            "items": {},
            "type": "array",
            "title": "Args"
          },
          "kwargs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Kwargs"
          },
          "init": {
            "additionalProperties": true,
            "type": "object",
            "title": "Init",
            "description": "Constructor overrides, for example a workspace"
          }
        },
        "type": "object",
        "required": [
          "method"
        ],
        "title": "RpcRequest"
      },
      "RpcResponse": {
        "properties": {
          "result": {
            "title": "Result"
          },
          "callbacks": {
            "additionalProperties": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Callbacks"
          }
        },
        "type": "object",
        "title": "RpcResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ConnectorApiKey": {
        "type": "apiKey",
        "description": "Service API key. The value is the `CONNECTOR_SERVICE_API_KEY` app setting of this connector service. Store it in Key Vault; never paste it into tickets or chat.",
        "in": "header",
        "name": "X-Connector-Api-Key"
      }
    }
  },
  "servers": [
    {
      "url": "https://<api-app>-jira.azurewebsites.net"
    }
  ],
  "security": [
    {
      "ConnectorApiKey": []
    }
  ]
}
