{
  "openapi": "3.1.0",
  "info": {
    "title": "SharePoint read-only tools",
    "version": "1.0.0",
    "description": "Read-only lookups in SharePoint for Agentic SDLC agents. Use them to ground proposals in existing records. These tools cannot create or modify anything; changes are proposed in the agent's output and published only after human approval."
  },
  "paths": {
    "/api/v1/sites/resolve": {
      "get": {
        "summary": "Resolve a SharePoint site by URL (read-only)",
        "operationId": "sharepoint_resolve_site",
        "security": [
          {
            "ConnectorApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Absolute site URL. Defaults to SHAREPOINT_SITE_URL.",
              "title": "Url"
            },
            "description": "Absolute site URL. Defaults to SHAREPOINT_SITE_URL."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Resolve Site Api V1 Sites Resolve Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Connector-Api-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Connector disabled, in mock mode, or not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The external system rejected or failed the call",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service credential or API key not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConnectivityResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "connected or failed",
            "examples": [
              "connected"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "connector": {
            "type": "string",
            "title": "Connector"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "durationMs": {
            "type": "integer",
            "title": "Durationms"
          },
          "identity": {
            "additionalProperties": true,
            "type": "object",
            "title": "Identity",
            "description": "Non-secret identity summary"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "mode",
          "durationMs"
        ],
        "title": "ConnectivityResponse"
      },
      "DocumentUploadBody": {
        "properties": {
          "project": {
            "$ref": "#/components/schemas/ProjectRef"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Category key from the connector's categoryFolders configuration",
            "default": "supporting",
            "examples": [
              "requirements"
            ]
          },
          "fileName": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Filename",
            "examples": [
              "connector-verification.md"
            ]
          },
          "contentBase64": {
            "type": "string",
            "title": "Contentbase64",
            "description": "Base64-encoded file content (max 25 MB decoded)"
          },
          "contentType": {
            "type": "string",
            "title": "Contenttype",
            "default": "application/octet-stream",
            "examples": [
              "text/markdown; charset=utf-8"
            ]
          }
        },
        "type": "object",
        "required": [
          "project",
          "fileName",
          "contentBase64"
        ],
        "title": "DocumentUploadBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlationid"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "examples": [
              "jira-connector"
            ]
          },
          "connector": {
            "type": "string",
            "title": "Connector",
            "examples": [
              "jira"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "1.0.0"
            ]
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "live, mock, or disabled",
            "examples": [
              "live"
            ]
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "version",
          "mode",
          "timestamp"
        ],
        "title": "LivenessResponse"
      },
      "ProjectRef": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id",
            "examples": [
              "3f9c2a7e-connector-verify"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "examples": [
              "Connector Verification"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "title": "Description",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "ProjectRef",
        "description": "The SDLC project a documentation operation belongs to."
      },
      "ReadinessCheckModel": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "JIRA_API_TOKEN"
            ]
          },
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "title": "ReadinessCheckModel"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "ready or not_ready",
            "examples": [
              "ready"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "connector": {
            "type": "string",
            "title": "Connector"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheckModel"
            },
            "type": "array",
            "title": "Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "connector",
          "mode",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "RpcRequest": {
        "properties": {
          "method": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Method",
            "examples": [
              "create_project"
            ]
          },
          "args": {
            "items": {},
            "type": "array",
            "title": "Args"
          },
          "kwargs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Kwargs"
          },
          "init": {
            "additionalProperties": true,
            "type": "object",
            "title": "Init",
            "description": "Constructor overrides, for example a workspace"
          }
        },
        "type": "object",
        "required": [
          "method"
        ],
        "title": "RpcRequest"
      },
      "RpcResponse": {
        "properties": {
          "result": {
            "title": "Result"
          },
          "callbacks": {
            "additionalProperties": {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Callbacks"
          }
        },
        "type": "object",
        "title": "RpcResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "ConnectorApiKey": {
        "type": "apiKey",
        "description": "Service API key. The value is the `CONNECTOR_SERVICE_API_KEY` app setting of this connector service. Store it in Key Vault; never paste it into tickets or chat.",
        "in": "header",
        "name": "X-Connector-Api-Key"
      }
    }
  },
  "servers": [
    {
      "url": "https://<api-app>-sharepoint.azurewebsites.net"
    }
  ],
  "security": [
    {
      "ConnectorApiKey": []
    }
  ]
}
